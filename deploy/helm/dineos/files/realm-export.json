{
  "realm": "dineos",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "SuperAdmin",   "composite": false, "clientRole": false },
      { "name": "Manager",      "composite": false, "clientRole": false },
      { "name": "Cashier",      "composite": false, "clientRole": false },
      { "name": "KitchenStaff", "composite": false, "clientRole": false },
      {
        "name": "Owner",
        "description": "Account-level role for the business Keycloak account (#staff-pin-auth Phase 2): gates staff management + billing. Composite over Manager BY DESIGN (permanent, decided 2026-05-31).",
        "composite": true,
        "composites": { "realm": ["Manager"] },
        "clientRole": false
      },
      {
        "name": "Demo",
        "description": "Composite role for shared demo tenant access (#216). Includes Owner + Manager + KitchenStaff so demo users get the full owner experience incl. staff management and the kitchen board.",
        "composite": true,
        "composites": { "realm": ["Owner", "Manager", "KitchenStaff"] },
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "dineos-api",
      "name": "DineOS API",
      "description": "Backend resource server — accepts bearer tokens only",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "dineos-admin",
      "name": "DineOS Admin (server-to-server)",
      "description": "Backend service-account client for Keycloak Admin API calls (owner provisioning on Stripe checkout).",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-admin-secret-change-me",
      "protocol": "openid-connect"
    },
    {
      "clientId": "dineos-frontend",
      "name": "DineOS Frontend",
      "description": "Public SPA client — used by the frontend and for local dev token fetching",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "dineos-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dineos-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5000/swagger/oauth2-redirect.html",
        "http://localhost:5138/swagger/oauth2-redirect.html",
        "https://localhost:7202/swagger/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5000",
        "http://localhost:5138",
        "https://localhost:7202"
      ]
    },
    {
      "clientId": "dineos-google",
      "name": "DineOS Google Login",
      "description": "Confidential backend client for Google sign-in through Keycloak.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "{{ .Values.secrets.keycloakGoogleClientSecret }}",
      "protocol": "openid-connect",
      "redirectUris": [
        "{{ .Values.api.env.Keycloak__GoogleCallbackUrl }}"
      ],
      "webOrigins": [
        "{{ .Values.api.env.Keycloak__FrontendUrl }}"
      ],
      "protocolMappers": [
        {
          "name": "dineos-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dineos-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "updateProfileFirstLoginMode": "missing",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login auto link by email",
      "config": {
        "clientId": "{{ .Values.secrets.googleClientId }}",
        "clientSecret": "{{ .Values.secrets.googleClientSecret }}",
        "defaultScope": "openid profile email"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "first broker login auto link by email",
      "description": "Create a brokered user when the email is unique, or auto-link Google to the existing trusted-email account.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-review-profile",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "flowAlias": "first broker login auto link by email user creation or linking",
          "userSetupAllowed": false,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "first broker login auto link by email user creation or linking",
      "description": "Create a unique brokered user or automatically link the matching existing user.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "idp-auto-link",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-dineos-admin",
      "enabled": true,
      "serviceAccountClientId": "dineos-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "manage-realm"]
      }
    },
    {
      "username": "admin@dineos.dev",
      "email": "admin@dineos.dev",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "Test1234!", "temporary": false }
      ],
      "realmRoles": ["SuperAdmin"]
    },
    {
      "username": "manager@dineos.dev",
      "email": "manager@dineos.dev",
      "firstName": "Manager",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["1"]
      },
      "credentials": [
        { "type": "password", "value": "Test1234!", "temporary": false }
      ],
      "realmRoles": ["Manager"]
    },
    {
      "username": "cashier@dineos.dev",
      "email": "cashier@dineos.dev",
      "firstName": "Cashier",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["1"]
      },
      "credentials": [
        { "type": "password", "value": "Test1234!", "temporary": false }
      ],
      "realmRoles": ["Cashier"]
    },
    {
      "username": "kitchen@dineos.dev",
      "email": "kitchen@dineos.dev",
      "firstName": "Kitchen",
      "lastName": "Staff",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["1"]
      },
      "credentials": [
        { "type": "password", "value": "Test1234!", "temporary": false }
      ],
      "realmRoles": ["KitchenStaff"]
    }
  ]
}
