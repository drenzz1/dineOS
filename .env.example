# =============================================================================
# DineOS — Docker Compose environment template
# =============================================================================
#
# SETUP
#   cp .env.example .env
#   # Edit .env and fill in real secrets (Stripe, AI keys, etc.)
#   docker compose up -d
#
# NOTES
#   • .env is git-ignored. This file (.env.example) is tracked.
#   • Every default here matches `docker compose up -d` with zero config.
#   • Variables named Foo__Bar use .NET's double-underscore config convention
#     and are passed directly as environment variables to the api container.
#   • Keep RABBITMQ_DEFAULT_USER/PASS in sync with RabbitMq__UserName/Password.
#   • Keep POSTGRES_* in sync with ConnectionStrings__DefaultConnection.
# =============================================================================

# === Ports ===================================================================
# Override to avoid conflicts with other services running locally.
NGINX_HTTP_PORT=80
FRONTEND_PORT=3000
API_HTTP_PORT=5001
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
LOKI_PORT=3100
GRAFANA_PORT=4000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
PGADMIN_PORT=5050
ES_PORT=9200
KIBANA_PORT=5601
UPTIME_KUMA_PORT=3001

# === API runtime ==============================================================
ASPNETCORE_ENVIRONMENT=Development

# === PostgreSQL ===============================================================
POSTGRES_DB=dineos
POSTGRES_USER=dineos
POSTGRES_PASSWORD=dineos_dev

# Full ADO.NET connection string passed to the .NET API.
# If you change POSTGRES_* above, update this line to match.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=dineos;Username=dineos;Password=dineos_dev

# === CORS =====================================================================
# Origins accepted by the .NET API (nginx on 80, frontend direct on 3000).
AllowedOrigins__0=http://localhost
AllowedOrigins__1=http://localhost:3000

# === Keycloak — container =====================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true

# === Keycloak — API (.NET config) ============================================
# *AuthServerUrl / MetadataAddress use the internal container hostname.
# *Authority / PublicAuthServerUrl use the host-visible URL (browser redirect).
Keycloak__Realm=dineos
Keycloak__Authority=http://localhost:8080/realms/dineos
Keycloak__AuthServerUrl=http://keycloak:8080
Keycloak__PublicAuthServerUrl=http://localhost:8080
Keycloak__MetadataAddress=http://keycloak:8080/realms/dineos/.well-known/openid-configuration
Keycloak__Audience=dineos-api
Keycloak__ClientId=dineos-frontend
Keycloak__GrantType=password
Keycloak__RequireHttpsMetadata=false
Keycloak__AdminClientId=dineos-admin
Keycloak__AdminClientSecret=dev-admin-secret-change-me
Keycloak__GoogleClientId=dineos-google
Keycloak__GoogleClientSecret=dev-google-auth-client-secret-change-me
Keycloak__GoogleCallbackUrl=http://localhost/api/v1/auth/google/callback
Keycloak__FrontendUrl=http://localhost

# Google OAuth credentials used by the Keycloak identity provider.
# Add http://localhost:8080/realms/dineos/broker/google/endpoint as an
# authorized redirect URI in Google Cloud for local Docker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Redis ====================================================================
Redis__ConnectionString=redis:6379

# === RabbitMQ — container =====================================================
# Must match RabbitMq__UserName / RabbitMq__Password below.
RABBITMQ_DEFAULT_USER=dineos
RABBITMQ_DEFAULT_PASS=dineos_dev

# === RabbitMQ — API (.NET config) ============================================
RabbitMq__Enabled=true
RabbitMq__HostName=rabbitmq
RabbitMq__Port=5672
RabbitMq__UserName=dineos
RabbitMq__Password=dineos_dev

# === Loki =====================================================================
Loki__Uri=http://loki:3100

# === ELK (elk profile — opt-in) ===============================================
# Only started with: docker compose --profile elk up
Logstash__Uri=http://logstash:5001

# === Mail / SMTP ==============================================================
# MailHog is the default dev mail sink — open http://localhost:8025 to view mail.
Smtp__Host=mailhog
Smtp__Port=1025
Smtp__UseStartTls=false
Email__Enabled=true
Email__FromAddress=no-reply@dineos.local
Email__FromName=DineOS
Email__SimulateFailure=false

# === Grafana ==================================================================
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_AUTH_DISABLE_LOGIN_FORM=false
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# === pgAdmin (tools profile) =================================================
# Only started with: docker compose --profile tools up
PGADMIN_DEFAULT_EMAIL=admin@dineos.dev
PGADMIN_DEFAULT_PASSWORD=admin

# === Frontend =================================================================
# NEXT_PUBLIC_* vars are embedded in the browser bundle at build time.
#   NEXT_PUBLIC_API_URL — entry via nginx (default). Use http://localhost:5001/api
#     to bypass nginx and hit the API directly.
#   API_INTERNAL_URL    — used by Next.js SSR / route handlers inside the
#     container; must point to the internal Docker service name.
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost/api
API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=dineos

# === Stripe (billing) =========================================================
# Leave blank — the app degrades gracefully when Stripe is not configured.
# See backend/README.md for full setup instructions and webhook forwarding.
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__ProMonthlyPriceId=
Stripe__ProAnnualPriceId=
Stripe__CheckoutSuccessUrl=http://localhost:3000/settings/billing?status=success
Stripe__CheckoutCancelUrl=http://localhost:3000/settings/billing?status=cancelled
Stripe__PortalReturnUrl=http://localhost:3000/settings/billing

# === Slack alerts (Alertmanager + API SlackNotifier + Uptime Kuma) ============
# Incoming Webhook URL from your Slack App (api.slack.com/apps → Incoming Webhooks).
# Used by:
#   - Alertmanager (entrypoint sed substitution -> global.slack_api_url / slack-direct receiver)
#   - The dineOS API's SlackNotifier (Slack__WebhookUrl) for AI-triage result posts
#   - Uptime Kuma bootstrap.sh (--profile uptime)
# Leave as placeholder for local dev — the API logs a warning and no-ops if empty.
# NEVER commit a real webhook URL — set it only in your local .env file.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXXXXXX/BXXXXXXXX/placeholder

# === Alertmanager → dineOS backend webhook ====================================
# Shared secret for POST /api/v1/alerts/webhook.
# Used by: Alertmanager (X-Webhook-Secret header) and the API (AlertWebhook:SharedSecret).
# Both sides must match.  Leave empty to allow unauthenticated calls on a closed
# Docker network (acceptable for local dev; set a strong random value in staging/prod).
# NEVER commit a real secret — set it only in your local .env file.
ALERT_WEBHOOK_SECRET=

# === Uptime Kuma (uptime profile) =============================================
# Only used when running: docker compose --profile uptime up
# UPTIME_KUMA_SMTP_TO is the alert recipient for the Mailhog SMTP channel.
UPTIME_KUMA_SMTP_TO=ops@dineos.local

# === AI providers =============================================================
# Supply at least one key to enable AI-assisted features.
Anthropic__ApiKey=
Anthropic__Model=claude-sonnet-4-5
OpenAI__ApiKey=
GoogleAI__ApiKey=

# === n8n workflow automation (M5.8) ==========================================
# Self-hosted n8n that runs the "webhook -> LLM -> notification" pipeline.
# The committed workflow (deploy/n8n/workflows/order-triage.json) is imported and
# activated automatically on container startup, so the order-triage webhook is
# live with no manual GUI setup.  See docs/devops/n8n-automation.md.
#
# The workflow reuses the SAME secrets the API already uses — no new keys needed:
#   • Anthropic__ApiKey  -> mapped into n8n as ANTHROPIC_API_KEY (LLM call)
#   • Anthropic__Model   -> mapped into n8n as ANTHROPIC_MODEL
#   • SLACK_WEBHOOK_URL   -> the notification target (same Incoming Webhook above)
# Leave the AI key blank to run without LLM triage — the webhook still responds
# 200 with an "AI summary unavailable" message and Slack still receives a post.
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Belgrade
# Fixed key so saved credentials survive container restarts. Dev-only default —
# set a strong random value (and NEVER commit it) for any shared/staging instance.
N8N_ENCRYPTION_KEY=dineos-dev-n8n-encryption-key-change-me
