    "CheckoutCancelUrl": "http://localhost:3000/settings/billing?status=cancelled",
    "PortalReturnUrl": "http://localhost:3000/settings/billing"
  },
  "Signup": {
    "FirstLoginUrl": ""
  },
  "Demo": {
    "Enabled": true,
    "TenantSlug": "demo-restaurant",
    "AccountTtlDays": 7,
    "LoginUrl": "http://localhost:3000/login",
    "RealmRole": "Demo",
    "CleanupCron": "0 3 * * *"
  },
  "StaffSession": {
    "SigningKey": "dev-staff-session-signing-key-change-me-0123456789",
    "Issuer": "dineos-staff-session",
    "Audience": "dineos-api",
    "TokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeMinutes": 720
  }
