{
  "AllowedHosts": "*",
  "FileStorage": {
    "RootPath": "/app/uploads"
  },
  "AllowedOrigins": [
    "http://localhost:3000"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dineos;Username=dineos;Password=dineos_dev;Trust Server Certificate=true"
  },
  "Loki": {
    "Uri": ""
  },
  "Logstash": {
    "Uri": ""
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "dineos",
    "Password": "dineos_dev",
    "VirtualHost": "/",
    "ExchangeName": "dineos.events",
    "DeadLetterExchangeName": "dineos.events.dlx",
    "OrderCreatedRoutingKey": "orders.created",
    "OrderCreatedQueueName": "dineos.orders.created.notifications",
    "OrderCreatedDeadLetterQueueName": "dineos.orders.created.notifications.dlq"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Email": {
    "Enabled": true,
    "FromAddress": "no-reply@dineos.local",
    "FromName": "DineOS",
    "SimulateFailure": false
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "UseStartTls": false
  },
  "Hangfire": {
    "Dashboard": {
      "AllowAnonymous": null
    }
  },
  "Ai": {
    "Provider": "Anthropic"
  },
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-sonnet-4-5",
    "BaseUrl": "https://api.anthropic.com",
    "ApiVersion": "2023-06-01",
    "MaxTokens": 400,
    "TimeoutSeconds": 20
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com",
    "MaxTokens": 400,
    "TimeoutSeconds": 20
  },
  "GoogleAI": {
    "ApiKey": "",
    "Model": "gemini-2.5-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "ApiVersion": "v1beta",
    "MaxTokens": 400,
    "TimeoutSeconds": 20
  },
  "Unleash": {
    "Enabled": false,
    "ApiUrl": "http://localhost:4242/api/",
    "ApiToken": "",
    "AppName": "dineos-api",
    "FetchTogglesIntervalSeconds": 15
  },
  "AlertWebhook": {
    "SharedSecret": ""
  },
  "Slack": {
    "WebhookUrl": "",
    "TimeoutSeconds": 10
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "ProMonthlyPriceId": "",
    "ProAnnualPriceId": "",
