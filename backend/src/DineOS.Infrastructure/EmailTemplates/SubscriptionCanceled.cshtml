@model DineOS.Application.Notifications.SubscriptionCanceledEmailModel
@{
    Layout = "_Layout.cshtml";
    ViewBag.Title = "Your dineOS subscription has been canceled";
}
<h2 style="margin:0 0 12px;font-size:20px;color:#0f172a;">Subscription canceled</h2>
<p style="margin:0 0 16px;">Hi @Model.OwnerName,</p>
<p style="margin:0 0 16px;">
  Your dineOS Pro subscription for <strong>@Model.RestaurantName</strong> has been canceled.
  Your account has been moved back to the Free plan.
</p>
<p style="margin:0 0 16px;">
  You can resubscribe at any time from the Billing page in your dineOS settings.
</p>
<p style="margin:16px 0 0;color:#94a3b8;font-size:13px;">
  If you did not request this cancellation, please contact us immediately.
</p>
