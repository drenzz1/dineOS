@model DineOS.Application.Notifications.SubscriptionActivatedEmailModel
@{
    Layout = "_Layout.cshtml";
    ViewBag.Title = "Welcome to dineOS Pro";
}
<h2 style="margin:0 0 12px;font-size:20px;color:#0f172a;">You're on dineOS Pro!</h2>
<p style="margin:0 0 16px;">Hi @Model.OwnerName,</p>
<p style="margin:0 0 16px;">
  Your <strong>@Model.RestaurantName</strong> subscription is now active. Everything on the Pro plan is unlocked.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:8px 0 20px;border-collapse:collapse;">
  <tr>
    <td style="padding:12px 14px;background:#f1f5f9;border-radius:8px 0 0 8px;">
      <div style="color:#64748b;font-size:12px;text-transform:uppercase;letter-spacing:.6px;">Plan</div>
      <div style="font-size:18px;font-weight:700;color:#0f172a;">Pro · @Model.BillingCycle</div>
    </td>
    @if (Model.CurrentPeriodEnd.HasValue)
    {
    <td style="padding:12px 14px;background:#f1f5f9;border-radius:0 8px 8px 0;border-left:1px solid #e2e8f0;">
      <div style="color:#64748b;font-size:12px;text-transform:uppercase;letter-spacing:.6px;">Next renewal</div>
      <div style="font-size:18px;font-weight:700;color:#0f172a;">@Model.CurrentPeriodEnd.Value.ToString("MMM d, yyyy")</div>
    </td>
    }
  </tr>
</table>

<p style="margin:16px 0 0;color:#94a3b8;font-size:13px;">You can manage your subscription from the Billing page in your dineOS settings.</p>
