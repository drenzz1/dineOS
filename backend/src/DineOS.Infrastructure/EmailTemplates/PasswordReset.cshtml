@model DineOS.Application.Notifications.PasswordResetEmailModel
@{
    Layout = "_Layout.cshtml";
    ViewBag.Title = "Reset your DineOS password";
}
<h2 style="margin:0 0 12px;font-size:20px;color:#0f172a;">Reset your password</h2>
<p style="margin:0 0 16px;">Hi,</p>
<p style="margin:0 0 16px;">
  We received a request to reset the DineOS password for
  <strong>@Model.Email</strong>. Use the code below to choose a new password.
</p>
<div style="margin:24px 0;padding:18px;background:#f1f5f9;border-radius:8px;text-align:center;">
  <div style="font-size:32px;font-weight:700;letter-spacing:6px;color:#0f172a;">@Model.Code</div>
</div>
<p style="margin:0 0 8px;color:#475569;">This code expires in @Model.CodeTtlMinutes minutes.</p>
<p style="margin:16px 0 0;color:#94a3b8;font-size:13px;">If you didn't request a password reset, you can ignore this email — your password is unchanged.</p>
