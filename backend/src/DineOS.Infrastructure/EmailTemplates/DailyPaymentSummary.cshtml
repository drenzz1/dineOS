@model DineOS.Application.Notifications.DailyPaymentSummaryEmailModel
@{
    Layout = "_Layout.cshtml";
    ViewBag.Title = $"Daily payment summary — {Model.Date:yyyy-MM-dd}";
}
<h2 style="margin:0 0 12px;font-size:20px;color:#0f172a;">Daily payment summary</h2>
<p style="margin:0 0 16px;">Hi @Model.OwnerName,</p>
<p style="margin:0 0 16px;">
  Here's the payment summary for <strong>@Model.RestaurantName</strong> on
  <strong>@Model.Date.ToString("dddd, MMM d, yyyy")</strong>.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:8px 0 20px;border-collapse:collapse;">
  <tr>
    <td style="padding:12px 14px;background:#f1f5f9;border-radius:8px 0 0 8px;">
      <div style="color:#64748b;font-size:12px;text-transform:uppercase;letter-spacing:.6px;">Revenue</div>
      <div style="font-size:22px;font-weight:700;color:#0f172a;">@Model.TotalRevenue.ToString("C")</div>
    </td>
    <td style="padding:12px 14px;background:#f1f5f9;border-radius:0 8px 8px 0;border-left:1px solid #e2e8f0;">
      <div style="color:#64748b;font-size:12px;text-transform:uppercase;letter-spacing:.6px;">Payments</div>
      <div style="font-size:22px;font-weight:700;color:#0f172a;">@Model.PaymentCount</div>
    </td>
  </tr>
</table>

@if (Model.ByMethod.Count > 0)
{
    <h3 style="margin:18px 0 8px;font-size:15px;color:#0f172a;">By payment method</h3>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
      <tr style="color:#64748b;font-size:12px;text-transform:uppercase;letter-spacing:.6px;">
        <td style="padding:6px 0;">Method</td>
        <td style="padding:6px 0;text-align:right;">Count</td>
        <td style="padding:6px 0;text-align:right;">Total</td>
      </tr>
      @foreach (var item in Model.ByMethod)
      {
        <tr style="border-top:1px solid #e2e8f0;">
          <td style="padding:8px 0;">@item.Method</td>
          <td style="padding:8px 0;text-align:right;">@item.Count</td>
          <td style="padding:8px 0;text-align:right;">@item.Total.ToString("C")</td>
        </tr>
      }
    </table>
}
else
{
    <p style="margin:8px 0 0;color:#64748b;">No completed payments on this date.</p>
}
