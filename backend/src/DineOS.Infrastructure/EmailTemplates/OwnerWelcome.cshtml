@model DineOS.Application.Notifications.OwnerWelcomeEmailModel
@{
    Layout = "_Layout.cshtml";
    ViewBag.Title = "Welcome to DineOS";
}
<h2 style="margin:0 0 12px;font-size:20px;color:#0f172a;">Your DineOS account is ready</h2>
<p style="margin:0 0 16px;">Hi @Model.OwnerName,</p>
<p style="margin:0 0 16px;">
  Payment confirmed — your restaurant <strong>@Model.RestaurantName</strong> is live on DineOS.
  Set your password using the secure link below, then sign in at <strong>@Model.Email</strong>.
</p>
<p style="margin:24px 0;">
  <a href="@Model.SetPasswordUrl" style="display:inline-block;padding:14px 22px;background:#0f172a;color:#ffffff;border-radius:8px;text-decoration:none;font-weight:600;">Set your password</a>
</p>
<p style="margin:0 0 8px;color:#475569;font-size:13px;">
  Or copy this link into your browser:
</p>
<p style="margin:0 0 16px;color:#0f172a;font-size:13px;word-break:break-all;">
  <a href="@Model.SetPasswordUrl" style="color:#0f172a;text-decoration:underline;">@Model.SetPasswordUrl</a>
</p>
<p style="margin:16px 0 0;color:#94a3b8;font-size:13px;">
  This link is single-use and expires in 24 hours. If you didn't sign up for DineOS, you can safely ignore this email.
</p>
