@model DineOS.Application.Notifications.DemoWelcomeEmailModel
@{
    Layout = "_Layout.cshtml";
    ViewBag.Title = Model.IsReissue ? "Your DineOS demo credentials" : "Your DineOS demo is ready";
}
<h2 style="margin:0 0 12px;font-size:20px;color:#0f172a;">
  @(Model.IsReissue ? "Fresh demo credentials" : "Your DineOS demo is ready")
</h2>
<p style="margin:0 0 16px;">
  @if (Model.IsReissue)
  {
      <text>You requested another demo for <strong>@Model.DemoTenantName</strong>. Your previous password no longer works — use the new one below.</text>
  }
  else
  {
      <text>You're in. Use the credentials below to sign in and explore <strong>@Model.DemoTenantName</strong> with a Manager-equivalent role.</text>
  }
</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;width:100%;background:#f1f5f9;border-radius:8px;">
  <tr>
    <td style="padding:16px 18px;">
      <div style="font-size:12px;text-transform:uppercase;letter-spacing:.6px;color:#64748b;">Email</div>
      <div style="font-size:15px;font-weight:600;color:#0f172a;margin-top:2px;">@Model.Email</div>
    </td>
  </tr>
  <tr>
    <td style="padding:0 18px 16px;">
      <div style="font-size:12px;text-transform:uppercase;letter-spacing:.6px;color:#64748b;">Password</div>
      <div style="font-family:Menlo,Consolas,monospace;font-size:18px;font-weight:700;color:#0f172a;margin-top:2px;letter-spacing:1px;">@Model.TempPassword</div>
    </td>
  </tr>
</table>
<p style="margin:0 0 16px;">
  <a href="@Model.LoginUrl" style="display:inline-block;padding:12px 20px;background:#0f172a;color:#ffffff;border-radius:8px;text-decoration:none;font-weight:600;">Sign in to dineOS</a>
</p>
<p style="margin:16px 0 0;color:#94a3b8;font-size:13px;">
  Your demo access expires on <strong>@Model.ExpiresAt.ToString("yyyy-MM-dd")</strong>. Re-request from <a href="@Model.LoginUrl" style="color:#94a3b8;">the site</a> to extend it.
</p>
