{
  "title": "DineOS API",
  "uid": "dineos-api",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "All API Logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"dineos-api\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Errors & Warnings",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"dineos-api\"} |= `\"level\":\"Error\"` or `\"level\":\"Warning\"`",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "HTTP Requests",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"dineos-api\"} |= `HTTP`",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Search by Correlation ID",
      "description": "Filter logs for a specific request. Set the correlationId variable in the query.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"dineos-api\"} | json | CorrelationId=`$correlationId`",
          "legendFormat": ""
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "correlationId",
        "type": "textbox",
        "label": "Correlation ID",
        "current": { "value": "" }
      }
    ]
  }
}
