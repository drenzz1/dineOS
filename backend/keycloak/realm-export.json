{
  "realm": "dineos",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 30,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "SuperAdmin",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "Manager",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "Cashier",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "KitchenStaff",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "Owner",
        "description": "Account-level role for the business Keycloak account (#staff-pin-auth Phase 2): gates staff management + billing. Composite over Manager BY DESIGN (permanent, decided 2026-05-31) — see docs/backend/staff-pin-auth.md.",
        "composite": true,
        "composites": {
          "realm": [
            "Manager"
          ]
        },
        "clientRole": false
      },
      {
        "name": "Demo",
        "description": "Composite role for shared demo tenant access (#216). Includes Owner + Manager + KitchenStaff so demo users get the full owner experience incl. staff management and the kitchen board.",
        "composite": true,
        "composites": {
          "realm": [
            "Owner",
            "Manager",
            "KitchenStaff"
          ]
        },
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "dineos-api",
      "name": "DineOS API",
      "description": "Backend resource server \u2014 accepts bearer tokens only",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "dineos-admin",
      "name": "DineOS Admin (server-to-server)",
      "description": "Backend service-account client for Keycloak Admin API calls (owner provisioning on Stripe checkout).",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-admin-secret-change-me",
      "protocol": "openid-connect"
    },
    {
      "clientId": "dineos-frontend",
      "name": "DineOS Frontend",
      "description": "Public SPA client \u2014 used by the frontend and for local dev token fetching",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "dineos-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dineos-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5000/swagger/oauth2-redirect.html",
        "http://localhost:5138/swagger/oauth2-redirect.html",
        "https://localhost:7202/swagger/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5000",
        "http://localhost:5138",
        "https://localhost:7202"
      ]
    },
    {
      "clientId": "dineos-google",
      "name": "DineOS Google Login",
      "description": "Confidential backend client for Google sign-in through Keycloak.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "__GOOGLE_AUTH_CLIENT_SECRET__",
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost/api/v1/auth/google/callback",
        "http://localhost:5001/api/v1/auth/google/callback",
        "http://localhost:5138/api/v1/auth/google/callback",
        "https://localhost:7202/api/v1/auth/google/callback"
      ],
      "webOrigins": [
        "http://localhost",
        "http://localhost:3000",
        "http://localhost:5001",
        "http://localhost:5138",
        "https://localhost:7202"
      ],
      "protocolMappers": [
        {
          "name": "dineos-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dineos-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "updateProfileFirstLoginMode": "missing",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login auto link by email",
      "config": {
        "clientId": "__GOOGLE_CLIENT_ID__",
        "clientSecret": "__GOOGLE_CLIENT_SECRET__",
        "defaultScope": "openid profile email"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "first broker login auto link by email",
      "description": "Create a brokered user when the email is unique, or auto-link Google to the existing trusted-email account.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-review-profile",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "flowAlias": "first broker login auto link by email user creation or linking",
          "userSetupAllowed": false,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "first broker login auto link by email user creation or linking",
      "description": "Create a unique brokered user or automatically link the matching existing user.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "idp-auto-link",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-dineos-admin",
      "enabled": true,
      "serviceAccountClientId": "dineos-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-realm"
        ]
      }
    },
    {
      "username": "admin@dineos.dev",
      "email": "admin@dineos.dev",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Test1234!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SuperAdmin"
      ]
    },
    {
      "username": "manager@dineos.dev",
      "email": "manager@dineos.dev",
      "firstName": "Manager",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "1"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "Test1234!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Manager"
      ]
    },
    {
      "username": "cashier@dineos.dev",
      "email": "cashier@dineos.dev",
      "firstName": "Cashier",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "1"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "Test1234!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Cashier"
      ]
    },
    {
      "username": "kitchen@dineos.dev",
      "email": "kitchen@dineos.dev",
      "firstName": "Kitchen",
      "lastName": "Staff",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "1"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "Test1234!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "KitchenStaff"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}], \"unmanagedAttributePolicy\": \"ENABLED\"}"
          ]
        }
      }
    ]
  }
}
