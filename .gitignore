# Windows-style build output (directory with literal backslash in name, created on Windows)
backend/src/*/bin\\Debug/
backend/src/*/bin\\Release/
backend/tests/*/bin\\Debug/
backend/tests/*/bin\\Release/

# ai-os local workspace (memory + per-feature research/plan)
