{
  "info": {
    "name": "dineOS Backend API (v1)",
    "_postman_id": "d1ne0s-collection-2026-05-13",
    "description": "Full coverage of every controller in DineOS.Api. All requests use `{{baseUrl}}/api/v1` and pull the bearer token from `{{accessToken}}`. The **Auth → Login** request stores `accessToken` and `refreshToken` into the environment via a test script — run it first.\n\n**Roles:** SuperAdmin · Manager · Cashier · KitchenStaff.\n**Tenant scoping:** every authenticated endpoint reads `tenant_id` from the JWT; do not send a conflicting `X-Tenant-ID` header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:5000",          "type": "string" },
    { "key": "keycloakUrl",  "value": "http://localhost:8080",          "type": "string" },
    { "key": "realm",        "value": "dineos",                          "type": "string" },
    { "key": "clientId",     "value": "dineos-frontend",                 "type": "string" },
    { "key": "username",     "value": "superadmin",                      "type": "string" },
    { "key": "password",     "value": "ChangeMe123!",                    "type": "string" },
    { "key": "accessToken",  "value": "",                                "type": "string" },
    { "key": "refreshToken", "value": "",                                "type": "string" },
    { "key": "tenantId",     "value": "1",                               "type": "string" },
    { "key": "menuItemId",   "value": "1",                               "type": "string" },
    { "key": "orderId",      "value": "1",                               "type": "string" },
    { "key": "shiftId",      "value": "1",                               "type": "string" },
    { "key": "shiftNoteId",  "value": "1",                               "type": "string" },
    { "key": "staffId",      "value": "1",                               "type": "string" },
    { "key": "tableId",      "value": "1",                               "type": "string" },
    { "key": "restaurantId", "value": "1",                               "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/api/v1/health", "host": ["{{baseUrl}}"], "path": ["api","v1","health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login (saves tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.environment.set('accessToken', json.data.accessToken || json.data.AccessToken);",
                  "  pm.environment.set('refreshToken', json.data.refreshToken || json.data.RefreshToken);",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken || json.data.AccessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken || json.data.RefreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh"] }
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","logout"] }
          }
        },
        {
          "name": "GET /me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api","v1","me"] }
          }
        }
      ]
    },
